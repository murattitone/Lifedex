{
  "expo": {
    "name": "Hayat",
    "slug": "hayat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hayat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.hayat.personal",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.hayat.personal",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#3D6BF5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Hayat",
      "shortName": "Hayat",
      "themeColor": "#3D6BF5",
      "backgroundColor": "#F3F5F9",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": { "backgroundColor": "#0B0C10" }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3D6BF5"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kıble yönünü hesaplamak için konumuna ihtiyaç var."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ayet, tarif ve notlarına ekran görüntüsü / fotoğraf eklemek için galerine erişim gerekiyor.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini Face ID ile açmak için."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
